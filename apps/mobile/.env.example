# Copie para apps/mobile/.env e preencha. O prefixo EXPO_PUBLIC_ expõe ao app.
EXPO_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Endpoint da instância PowerSync (Milestone 1, quando a replicação for ligada)
EXPO_PUBLIC_POWERSYNC_URL="https://<instance>.powersync.journeyapps.com"

# Site de onde vêm as fotos das receitas (padrão: https://habitualfit.vercel.app).
# EXPO_PUBLIC_SITE_URL="https://habitualfit.vercel.app"
